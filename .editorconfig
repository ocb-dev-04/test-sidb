root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,targets,xml}]
indent_size = 2

[*.{ts,tsx,js,jsx,css,html}]
indent_size = 2
end_of_line = lf

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Organización de usings y namespaces
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_style_namespace_declarations = file_scoped:error
csharp_using_directive_placement = outside_namespace:error

# Estilo
csharp_style_var_for_built_in_types = false:error
csharp_style_var_when_type_is_apparent = false:error
csharp_style_var_elsewhere = false:error
csharp_prefer_braces = when_multiline:warning
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
dotnet_style_readonly_field = true:error
dotnet_style_require_accessibility_modifiers = for_non_interface_members:error
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_prefer_primary_constructors = false:suggestion
dotnet_diagnostic.IDE0005.severity = error
dotnet_diagnostic.IDE0161.severity = error

# Reglas de nombres obligatorias de la especificación técnica SB
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.interface_style.capitalization = pascal_case
dotnet_naming_style.interface_style.required_prefix = I
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_start_with_i.style = interface_style
dotnet_naming_rule.interfaces_start_with_i.severity = error

dotnet_naming_symbols.constant_symbols.applicable_kinds = field, local
dotnet_naming_symbols.constant_symbols.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected, local
dotnet_naming_symbols.constant_symbols.required_modifiers = const
dotnet_naming_style.upper_case_style.capitalization = all_upper
dotnet_naming_style.upper_case_style.word_separator = _
dotnet_naming_rule.constants_upper_case.symbols = constant_symbols
dotnet_naming_rule.constants_upper_case.style = upper_case_style
dotnet_naming_rule.constants_upper_case.severity = error

dotnet_naming_symbols.static_readonly_symbols.applicable_kinds = field
dotnet_naming_symbols.static_readonly_symbols.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected, local
dotnet_naming_symbols.static_readonly_symbols.required_modifiers = static, readonly
dotnet_naming_rule.static_readonly_upper_case.symbols = static_readonly_symbols
dotnet_naming_rule.static_readonly_upper_case.style = upper_case_style
dotnet_naming_rule.static_readonly_upper_case.severity = error

dotnet_naming_symbols.type_symbols.applicable_kinds = class, struct, enum, delegate, type_parameter
dotnet_naming_style.pascal_style.capitalization = pascal_case
dotnet_naming_rule.types_pascal_case.symbols = type_symbols
dotnet_naming_rule.types_pascal_case.style = pascal_style
dotnet_naming_rule.types_pascal_case.severity = error

dotnet_naming_symbols.member_symbols.applicable_kinds = method, property, event, enum_member
dotnet_naming_rule.members_pascal_case.symbols = member_symbols
dotnet_naming_rule.members_pascal_case.style = pascal_style
dotnet_naming_rule.members_pascal_case.severity = error

dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private, private_protected
dotnet_naming_style.underscore_camel_style.capitalization = camel_case
dotnet_naming_style.underscore_camel_style.required_prefix = _
dotnet_naming_rule.private_fields_underscore_camel.symbols = private_field_symbols
dotnet_naming_rule.private_fields_underscore_camel.style = underscore_camel_style
dotnet_naming_rule.private_fields_underscore_camel.severity = error

dotnet_naming_symbols.local_symbols.applicable_kinds = parameter, local, local_function
dotnet_naming_style.camel_style.capitalization = camel_case
dotnet_naming_rule.locals_camel_case.symbols = local_symbols
dotnet_naming_rule.locals_camel_case.style = camel_style
dotnet_naming_rule.locals_camel_case.severity = error

dotnet_diagnostic.IDE1006.severity = error
# CA1707 prohíbe '_' en miembros públicos y choca con las constantes en MAYÚSCULA que exige la especificación
dotnet_diagnostic.CA1707.severity = none
# CA1716 protege a consumidores en VB.NET; la solución es solo C#
dotnet_diagnostic.CA1716.severity = none

[{**/Migrations/*.cs,**/obj/**/*.cs}]
generated_code = true
dotnet_diagnostic.IDE0005.severity = none
dotnet_diagnostic.IDE1006.severity = none
