{
  "ConnectionStrings": {
    "SolicitudesDatabase": "Server=localhost,1433;Database=SBSolicitudes;User Id=sa;Password=SbSolicitudes#Dev2026;TrustServerCertificate=True;Encrypt=True",
    "GovernmentEntitiesSqlite": "Data Source=Data/entidades-gubernamentales.db"
  },
  "Jwt": {
    "Issuer": "SB.Solicitudes.Servicios",
    "Audience": "SB.Solicitudes.Web",
    "SigningKey": "solo-desarrollo-cambiar-por-variable-de-entorno-Jwt__SigningKey",
    "ExpirationMinutes": 60
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedOnStartup": true,
    "CommandTimeoutSeconds": 30,
    "MaximumRetryCount": 3,
    "SlowQueryThresholdMilliseconds": 500
  },
  "Notifications": {
    "Channels": [ "InApp", "Email" ],
    "Dispatch": {
      "Enabled": true,
      "PollingIntervalSeconds": 5,
      "BatchSize": 20,
      "EmailPickupDirectory": "simulated-mail"
    }
  },
  "GovernmentEntities": {
    "DefaultSource": "TextFile",
    "TextFilePath": "Data/entidades-gubernamentales.txt",
    "ExcelFilePath": "Data/ListaEntidadesGubernamentales.xlsx",
    "InitializeStoresOnStartup": true
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:8080" ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/solicitudes-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {TraceId} {UserId}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "SB.Solicitudes.Servicios"
    }
  },
  "AllowedHosts": "*"
}
